+#[cfg(all(windows, feature = "flutter"))]
+fn localist_gui_peer_is_trusted(peer_exe: &Path, current_exe: &Path, postfix: &str) -> bool {
+    if !postfix.is_empty() || crate::get_app_name() != "LocalistRemote" {
+        return false;
+    }
+    let (Some(peer_dir), Some(current_dir)) = (peer_exe.parent(), current_exe.parent()) else {
+        return false;
+    };
+    if !executable_paths_match(peer_dir, current_dir) {
+        return false;
+    }
+    let (Some(peer_name), Some(current_name)) = (peer_exe.file_name(), current_exe.file_name()) else {
+        return false;
+    };
+    let peer_name = peer_name.to_string_lossy();
+    let current_name = current_name.to_string_lossy();
+    let paired = (peer_name.eq_ignore_ascii_case("Localist.exe")
+        && current_name.eq_ignore_ascii_case("LocalistRemote.exe"))
+        || (peer_name.eq_ignore_ascii_case("LocalistRemote.exe")
+            && current_name.eq_ignore_ascii_case("Localist.exe"));
+    if !paired {
+        return false;
+    }
+    // The runner packages these as byte-identical siblings. Preserve the pipe's
+    // user/session authorization and reject unrelated executables or channels.
+    match (file_sha256(peer_exe), file_sha256(current_exe)) {
+        (Ok(peer), Ok(current)) => peer == current,
+        (peer, current) => {
+            log::warn!("Failed to verify Localist IPC executable pair: peer={:?}, current={:?}", peer.err(), current.err());
+            false
+        }
+    }
+}
