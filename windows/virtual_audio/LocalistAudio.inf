[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/09/2026,7.3.0.77
CatalogFile=LocalistAudio.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Localist,NTamd64.10.0...19041
[Localist.NTamd64.10.0...19041]
%Device%=LocalistAudio,ROOT\LocalistAudio

[SourceDisksNames]
1=%Disk%,,,
[SourceDisksFiles]
LocalistAudio.sys=1
[DestinationDirs]
Audio.Copy=13
[Audio.Copy]
LocalistAudio.sys

[LocalistAudio.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=Audio.Copy
AddReg=Audio.Reg
[Audio.Reg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,LocalistAudio.sys
HKR,,DoNotCreateDataFiles,0x10001,1
HKR,,DisableToneGenerator,0x10001,1
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%Device%
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Description,,%Device%

[LocalistAudio.NT.Services]
AddService=LocalistAudio,0x2,Audio.Service
[Audio.Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\LocalistAudio.sys

[LocalistAudio.NT.Wdf]
KmdfService=LocalistAudio,Audio.Wdf
[Audio.Wdf]
KmdfLibraryVersion=1.15

[LocalistAudio.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,WaveMicArray1,Audio.Wave1
AddInterface=%KSCATEGORY_REALTIME%,WaveMicArray1,Audio.Wave1
AddInterface=%KSCATEGORY_CAPTURE%,WaveMicArray1,Audio.Wave1
AddInterface=%KSCATEGORY_AUDIO%,TopologyMicArray1,Audio.Topo1
AddInterface=%KSCATEGORY_TOPOLOGY%,TopologyMicArray1,Audio.Topo1
AddInterface=%KSCATEGORY_AUDIO%,WaveMicArray2,Audio.Wave2
AddInterface=%KSCATEGORY_REALTIME%,WaveMicArray2,Audio.Wave2
AddInterface=%KSCATEGORY_CAPTURE%,WaveMicArray2,Audio.Wave2
AddInterface=%KSCATEGORY_AUDIO%,TopologyMicArray2,Audio.Topo2
AddInterface=%KSCATEGORY_TOPOLOGY%,TopologyMicArray2,Audio.Topo2
AddInterface=%KSCATEGORY_AUDIO%,WaveMicArray3,Audio.Wave3
AddInterface=%KSCATEGORY_REALTIME%,WaveMicArray3,Audio.Wave3
AddInterface=%KSCATEGORY_CAPTURE%,WaveMicArray3,Audio.Wave3
AddInterface=%KSCATEGORY_AUDIO%,TopologyMicArray3,Audio.Topo3
AddInterface=%KSCATEGORY_TOPOLOGY%,TopologyMicArray3,Audio.Topo3
AddInterface=%KSCATEGORY_AUDIO%,WaveMicArray4,Audio.Wave4
AddInterface=%KSCATEGORY_REALTIME%,WaveMicArray4,Audio.Wave4
AddInterface=%KSCATEGORY_CAPTURE%,WaveMicArray4,Audio.Wave4
AddInterface=%KSCATEGORY_AUDIO%,TopologyMicArray4,Audio.Topo4
AddInterface=%KSCATEGORY_TOPOLOGY%,TopologyMicArray4,Audio.Topo4

[Audio.Wave1]
AddReg=Audio.Wave1.Reg
[Audio.Wave1.Reg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Mic1%
[Audio.Topo1]
AddReg=Audio.Topo1.Reg
[Audio.Topo1.Reg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Mic1%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x10001,1

[Audio.Wave2]
