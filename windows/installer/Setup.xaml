<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="نصب برنامه" Width="900" Height="610" WindowStartupLocation="CenterScreen"
 ResizeMode="NoResize" WindowStyle="None" Background="#0B0F1B" Foreground="#F4F5FC"
 FlowDirection="RightToLeft" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#557BFF"/>
  <SolidColorBrush x:Key="AccentSurface" Color="#18557BFF"/>
  <SolidColorBrush x:Key="AccentBorder" Color="#70557BFF"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F4F5FC"/>
   <Setter Property="Background" Value="{DynamicResource AccentSurface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
   <Setter Property="Padding" Value="20,11"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
     <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/><Trigger.EnterActions><BeginStoryboard><Storyboard>
      <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.16"/>
      <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.16"/>
     </Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard>
      <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/>
      <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/>
     </Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Viewbox Stretch="Uniform">
 <Border Width="900" Height="610" Background="#0B0F1B" BorderBrush="#303A4E" BorderThickness="1" CornerRadius="18" ClipToBounds="True">
 <Grid FlowDirection="LeftToRight">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="294"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="#263148" BorderThickness="1,0,0,0">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#20203A"/><GradientStop Color="#111727" Offset="0.6"/><GradientStop Color="#172330" Offset="1"/></LinearGradientBrush></Border.Background>
   <Grid ClipToBounds="True" FlowDirection="RightToLeft">
    <Ellipse x:Name="Orbit" Width="410" Height="410" Stroke="#58617A" StrokeThickness="1" Opacity="0.20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,42,0,0"/>
    <Ellipse Width="340" Height="340" Stroke="#64708C" StrokeThickness="1" Opacity="0.18" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,77,0,0"/>
    <Ellipse x:Name="Halo" Width="245" Height="245" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,126,0,0">
     <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#366D4BFF"/><GradientStop Color="#006D4BFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
    </Ellipse>
    <StackPanel Margin="28,38,28,0">
     <TextBlock Text="MBN · FOR WINDOWS" FontSize="11" Foreground="#9DAAC4" FlowDirection="LeftToRight" TextAlignment="Center"/>
     <Border x:Name="LogoFrame" Width="112" Height="112" Margin="0,118,0,20" CornerRadius="28" Background="#242B40" BorderBrush="#54607B" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      <Image x:Name="Logo" Width="86" Height="86"/>
     </Border>
     <TextBlock x:Name="ProductName" FontSize="28" FontWeight="Bold" FlowDirection="LeftToRight" TextAlignment="Center"/>
     <TextBlock x:Name="ProductCaption" Text="دستگاه‌هایت، در یک شبکه" FontSize="14" Foreground="#BBC4D6" TextAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Bottom" Margin="28,0,28,42">
     <Border Background="#192337" CornerRadius="14" Padding="14" BorderBrush="#364057" BorderThickness="1">
      <StackPanel><TextBlock x:Name="PreservationCaption" Text="تنظیمات و فایل‌هایت محفوظ می‌مانند" FontSize="12" FontWeight="Medium"/><TextBlock x:Name="PreservationDetail" Text="نصب یا بروزرسانی، بدون شروع دوباره" FontSize="11" Foreground="#AAB6CE" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
     </Border>
     <TextBlock Text="Windows 10 / 11   ·   64 bit" FontSize="10" Foreground="#8190AC" FlowDirection="LeftToRight" TextAlignment="Center" Margin="0,19,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid x:Name="TitleBar" Grid.Column="0" Margin="18,0,26,0">
   <Button x:Name="CloseButton" Content="×" Width="34" Height="32" Padding="0" FontSize="23" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" AutomationProperties.Name="بستن ستاپ"/>
   <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="#A2ACC0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
  </Grid>
  <Grid Grid.Row="1" Grid.Column="0" Margin="38,14,38,0" FlowDirection="RightToLeft">
   <Grid x:Name="Page" Opacity="0">
    <Grid.RenderTransform><TranslateTransform Y="18"/></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <Border Background="#242D3A" CornerRadius="8" Padding="10,5" HorizontalAlignment="Right"><TextBlock x:Name="Eyebrow" Text="به دنیای MBN خوش آمدی" FontSize="11" Foreground="{DynamicResource Accent}"/></Border>
     <TextBlock x:Name="Headline" Text="شروع یک تجربهٔ تازه" FontSize="29" FontWeight="Bold" Margin="0,19,0,10"/>
     <TextBlock x:Name="Description" Text="چند لحظه تا اتصال دستگاه‌ها. مسیر نصب را انتخاب کنید." TextWrapping="Wrap" FontSize="14" Foreground="#B2BDD1" LineHeight="25"/>
    </StackPanel>
    <StackPanel x:Name="InstallOptions" Grid.Row="1" Margin="0,30,0,0">
     <TextBlock x:Name="PathLabel" Text="مسیر نصب" FontSize="12" Foreground="#9FACC2" Margin="0,0,0,9"/>
     <Border Background="#131B2A" CornerRadius="12" BorderBrush="#344158" BorderThickness="1" Padding="6">
      <DockPanel FlowDirection="LeftToRight"><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="انتخاب" Padding="13,8" FontSize="12"/><TextBox x:Name="InstallPath" Background="Transparent" BorderThickness="0" Foreground="#E4E9F4" FontSize="12" VerticalContentAlignment="Center" Padding="10,3" FlowDirection="LeftToRight"/></DockPanel>
     </Border>
     <TextBlock x:Name="Detection" FontSize="12" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,10,0,0"/>
     <CheckBox x:Name="DesktopShortcut" Content="میان‌بر روی دسکتاپ ساخته شود" IsChecked="True" FontSize="12" Foreground="#D0D8E8" Margin="0,18,0,0" VerticalContentAlignment="Center"/>
    </StackPanel>
    <StackPanel x:Name="ProgressPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,38,0,0">
     <Grid x:Name="ProgressHeader" FlowDirection="LeftToRight">
      <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="PercentLabel" Grid.Column="0" Text="۰٪" FlowDirection="LeftToRight" TextAlignment="Left" VerticalAlignment="Center" FontSize="21" Foreground="{DynamicResource Accent}"/>
      <TextBlock x:Name="StepLabel" Grid.Column="2" Text="آماده‌سازی" FlowDirection="RightToLeft" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14"/>
     </Grid>
     <Border Height="9" CornerRadius="4" Background="#232D40" Margin="0,18,0,19" ClipToBounds="True" FlowDirection="LeftToRight"><Grid x:Name="ProgressTrack"><Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource Accent}"/></Grid></Border>
     <TextBlock x:Name="ProgressDetail" Text="فایل‌ها با دقت آماده می‌شوند…" FontSize="12" Foreground="#9EACC3" TextWrapping="Wrap" LineHeight="23"/>
     <Border x:Name="SuccessMark" Visibility="Collapsed" Margin="0,25,0,0" Background="#123D32" BorderBrush="#25775C" BorderThickness="1" Padding="17" CornerRadius="14"><TextBlock x:Name="SuccessLabel" Text="✓   نصب با موفقیت انجام شد" Foreground="#85E8BF" FontSize="15" FontWeight="Medium"/></Border>
    </StackPanel>
    <TextBlock x:Name="ErrorLabel" Grid.Row="2" Foreground="#FFAFB8" TextWrapping="Wrap" FontSize="12" Margin="0,20,0,10" VerticalAlignment="Top"/>
    <Grid Grid.Row="3" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="PrimaryButton" Content="نصب برنامه  ←" Background="{DynamicResource Accent}" Foreground="#131824" BorderBrush="Transparent" Padding="25,13" FontWeight="Bold" FontSize="15" IsDefault="True" Margin="0,0,12,0"/>
     <Button x:Name="SecondaryButton" Grid.Column="1" Content="انصراف" Padding="20,13"/>
    </Grid>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="2" Grid.Column="0" Text="انتقال فایل، کنترل از راه دور و ارتباط محلی" FontSize="10" Foreground="#697A98" HorizontalAlignment="Center"/>
 </Grid>
 </Border>
 </Viewbox>
</Window>
