if(NOT EXISTS "${REMOTE_RUNTIME}/librustdesk.dll")
  message(FATAL_ERROR "Bundled Remote Control native runtime is missing.")
endif()
file(COPY "${REMOTE_RUNTIME}/" DESTINATION "${OUTPUT}")
if(EXISTS "${OUTPUT}/LocalistRemote.exe")
  execute_process(COMMAND "${RESOURCE_TOOL}" --unhide "${OUTPUT}/LocalistRemote.exe" RESULT_VARIABLE metadata_result)
  if(NOT metadata_result EQUAL 0)
    message(FATAL_ERROR "Unable to prepare the hidden remote helper for update.")
  endif()
endif()
file(COPY_FILE "${APP_EXE}" "${OUTPUT}/LocalistRemote.exe" ONLY_IF_DIFFERENT)
file(SHA256 "${APP_EXE}" app_digest)
file(SHA256 "${OUTPUT}/LocalistRemote.exe" helper_digest)
if(NOT app_digest STREQUAL helper_digest)
  message(FATAL_ERROR "Remote IPC requires byte-identical Localist executable siblings.")
endif()
execute_process(COMMAND "${RESOURCE_TOOL}" "${OUTPUT}/LocalistRemote.exe" RESULT_VARIABLE hide_result)
if(NOT hide_result EQUAL 0)
  message(FATAL_ERROR "Unable to hide the helper executable.")
endif()
file(COPY_FILE "${REMOTE_PACKAGE}/LICENSE" "${OUTPUT}/REMOTE-LICENSE.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${REMOTE_PACKAGE}/UPSTREAM.json" "${OUTPUT}/REMOTE-UPSTREAM.json" ONLY_IF_DIFFERENT)
file(COPY_FILE "${REMOTE_PACKAGE}/native-source.tar.gz" "${OUTPUT}/REMOTE-SOURCE.tar.gz" ONLY_IF_DIFFERENT)
